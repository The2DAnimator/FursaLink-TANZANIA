# ---------------------------------------------------------------------------
# FursaLink Tanzania — environment configuration
# Copy to `.env` and fill in. All third-party keys are OPTIONAL: when omitted,
# the integration layer falls back to deterministic mock responses so the whole
# platform runs without any external accounts.
# ---------------------------------------------------------------------------

# Select settings module: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam
FRONTEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgres://fursalink:fursalink@localhost:5432/fursalink

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Run Celery tasks synchronously in dev (no worker required)
CELERY_TASK_ALWAYS_EAGER=False

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Throttling
THROTTLE_ANON=60/min
THROTTLE_USER=1000/min
THROTTLE_OTP=5/min

# Email
DEFAULT_FROM_EMAIL=no-reply@fursalink.co.tz
# Production SMTP (config.settings.prod)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=

# Production security toggles (config.settings.prod)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ---- External integrations (optional; blank = mock mode) ----
GOOGLE_MAPS_API_KEY=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
TIGO_API_KEY=

# ---- External data feeds (optional) ----
TENDERS_FEED_URL=
JOBS_FEED_URL=
